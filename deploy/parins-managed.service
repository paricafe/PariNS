# PariNS managed installer unit v3 (restricted updater contract)
[Unit]
Description=PariNS DNS forwarder and management console
After=network-online.target parins-update-recovery.service
Requires=parins-update-recovery.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=parins-managed
StateDirectoryMode=0700
RuntimeDirectory=parins-managed
RuntimeDirectoryMode=0700
WorkingDirectory=/var/lib/parins-managed
ExecStart=/opt/parins-managed/parins --manage --state-dir /var/lib/parins-managed --web-listen 0.0.0.0:3000
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# An accepted configuration transaction may drain the old DNS instance before
# shutdown drains its replacement (65s transaction + 62s DNS + 10s storage).
TimeoutStopSec=145
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
