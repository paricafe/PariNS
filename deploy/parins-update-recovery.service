# PariNS updater contract v1
[Unit]
Description=PariNS update boot recovery
Before=parins-managed.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/parins-updater boot-recover
TimeoutStartSec=60
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/parins-managed /var/lib/parins-updater
