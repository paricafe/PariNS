# PariNS updater contract v1
[Unit]
Description=PariNS restricted update transaction
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=oneshot
ExecStart=/usr/libexec/parins-updater run
ExecStopPost=/usr/libexec/parins-updater recover
# Candidate and rollback: each has a 160s stop bound, 60s start and 180s readiness.
TimeoutStartSec=900
# One recovery launch plus unit validation and durable file work.
TimeoutStopSec=480
Restart=no
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/opt/parins-managed /var/lib/parins-updater /var/lib/parins-managed /var/lib/private/parins-managed
MemoryMax=256M
TasksMax=32
